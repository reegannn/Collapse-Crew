# Roblox place files. The repo's source of truth is the code in src/,
# not a saved place file, so these are never committed.
# (Model files, .rbxm/.rbxmx, are deliberately NOT ignored: art assets may be
# committed as models during the M12 art pass.)
*.rbxl
*.rbxlx
*.rbxl.lock
*.rbxlx.lock

# Folders created by Wally (package manager) if it is ever used.
/Packages/
/ServerPackages/
/DevPackages/

# Generated by Rojo for editor tooling.
sourcemap.json

# Operating-system and editor clutter.
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Never commit secrets (API keys, Open Cloud credentials, etc.).
.env
.env.*
*.pem
*.key
